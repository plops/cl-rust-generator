# Kopieren nach `.env` und Secrets ersetzen.
DATABASE_URL=postgres://dating:dating_secret_dev@localhost:5432/dating_mvp
# 32 Bytes, base64 (44 Zeichen mit Padding). Erzeugen z.B. via:
#   python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
DATA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
PORT=3000
SESSION_SECRET=dev-session-secret-wechsel-mich-bitte-aus
RUST_LOG=info
# Stripe-Testmodus: leer lassen = Mock; mit Key = bereit für echte API.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=price_test_10eur_einmalig
# AI-Modus: mock (Default) oder http (OpenAI/Anthropic-kompatibler Endpoint).
AI_MODE=mock
AI_API_URL=
AI_API_KEY=
# Top-5-Job Intervall in Stunden (MVP-Default 24; für Demos kleiner setzbar).
MATCH_JOB_INTERVAL_HOURS=24
# Rate-Limit pro Peer-IP (echte Requests/Sekunde + Burst).
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_BURST=30
